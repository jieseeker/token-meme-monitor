# Core chain settings
BSC_RPC_URL=https://bnb.rpc.subquery.network/public
# Optional comma-separated RPC pool. If set, the first URL becomes the primary endpoint.
# Worker discovery will cool down 429/418 endpoints and switch to the next available URL.
BSC_RPC_URLS=
PANCAKESWAP_V2_FACTORY_ADDRESS=0xcA143Ce32Fe78f1f7019d7d551a6402fC5350c73

# Storage
MONITOR_DATABASE_PATH=data/monitor.db

# Monitor universe
MONITOR_UNIVERSE=binance_alpha
BINANCE_ALPHA_URL=https://www.binance.com/bapi/defi/v1/public/wallet-direct/buw/wallet/cex/alpha/all/token/list
BINANCE_ALPHA_REFRESH_MINUTES=1
BINANCE_ALPHA_SEED_BATCH_SIZE=30
BINANCE_FUTURES_REGISTRY_REFRESH_HOURS=6
DASHBOARD_AUTO_REFRESH_SECONDS=20

# Discovery tuning
DISCOVERY_START_BLOCK=
DISCOVERY_INITIAL_BACKFILL_BLOCKS=120
DISCOVERY_BLOCK_CHUNK_SIZE=250
DISCOVERY_BLOCK_CONFIRMATIONS=3

# Worker cadence
WORKER_LOOP_SECONDS=15
BASE_POLL_INTERVAL_SECONDS=60
FOCUS_POLL_INTERVAL_SECONDS=15
MAX_PAIRS_PER_CYCLE=80
MAX_PAIR_AGE_HOURS=24

# Signal tuning
FOCUS_SCORE_THRESHOLD=65
ALERT_SCORE_THRESHOLD=78
ALERT_COOLDOWN_MINUTES=30
MIN_LIQUIDITY_USD=15000
ARCHIVE_LIQUIDITY_USD=3000
MIN_VOLUME_H1_USD=15000
MIN_BUY_COUNT_M5=8
MIN_BUY_SELL_RATIO_M5=1.8
FOCUS_VOLUME_TO_LIQUIDITY_RATIO=0.25
STRATEGY_VERSION=v1

# Alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Logging
LOG_LEVEL=INFO

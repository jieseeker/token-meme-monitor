# Database
MONITOR_DATABASE_PATH=data/monitor.db

# Worker
WORKER_LOOP_SECONDS=15
MAX_PAIRS_PER_CYCLE=80
MIN_LIQUIDITY_USD=15000
ARCHIVE_LIQUIDITY_USD=3000
MIN_VOLUME_H1_USD=15000
MIN_BUY_COUNT_M5=8
MIN_BUY_SELL_RATIO_M5=1.8
FOCUS_VOLUME_TO_LIQUIDITY_RATIO=0.25

# Signal thresholds
FOCUS_SCORE_THRESHOLD=65
ALERT_SCORE_THRESHOLD=78
# Shadow diagnostics only; legacy scoring and scheduling remain the comparison.
SIGNAL_V2_MODE=legacy

# Dashboard
DASHBOARD_PORT=8501
# Optional BSC depth RPC endpoints (comma separated HTTPS URLs); public backups are built in.
BSC_DEPTH_RPC_URLS=
# Local HTTP proxy endpoints for GeckoTerminal only; each endpoint should have a distinct exit IP.
# Unreachable or rate-limited proxies are cooled down; direct access is the fallback.
GECKOTERMINAL_PROXY_URLS=

# Binance Alpha
BINANCE_ALPHA_URL=https://www.binance.com/bapi/defi/v1/public/wallet-direct/buw/wallet/cex/alpha/all/token/list
BINANCE_ALPHA_REFRESH_MINUTES=1

# Logging
LOG_LEVEL=INFO
